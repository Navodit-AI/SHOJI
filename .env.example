# Copy to .env and fill in. Never commit .env.

# Which upstream provider the proxy forwards to (Stage 1: groq)
SHOJI_PROVIDER=groq

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Optional, used later for provider fallback
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Upstream timeout in seconds
SHOJI_UPSTREAM_TIMEOUT=60

# Model used only when a request omits "model"
SHOJI_DEFAULT_MODEL=

# Retries for connection failures and 5xx responses (never mid-stream)
SHOJI_UPSTREAM_RETRIES=1
SHOJI_RETRY_BACKOFF=0.5

# Redact personal data before it reaches the provider (true/false; false = pass-through)
SHOJI_REDACT=true
# Ignore detections scoring below this (0-1)
SHOJI_MIN_SCORE=0.5

# Encrypted vault for placeholder mappings (optional). Without a key nothing is stored and
# each request is redacted from its own message history. Generate a key with:
#   python -m shoji.vault
SHOJI_VAULT_KEY=
SHOJI_VAULT_PATH=shoji_vault.db
# Conversations not used for this long are deleted
SHOJI_VAULT_TTL_HOURS=24
